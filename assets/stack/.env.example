# ─────────────────────────────────────────────────────────────────────────────
# Шаблон секретов AI-стека (порядок и набор переменных совпадают с ai/.env).
#
#   cp ai/.env.example ai/.env
#   chmod 640 ai/.env && chown root:ai_service ai/.env
#
# ai/.env в git не попадает (.gitignore). Значения не коммитить, не выводить в
# чат/логи, не копировать в тикеты. Переменные, отмеченные «[обязательна]»,
# проверяет deploy.sh (preflight): пустое значение = деплой не стартует.
# ─────────────────────────────────────────────────────────────────────────────

# ==== LiteLLM: ключи шлюза и провайдеров ====

# [обязательна] Мастер-ключ LiteLLM. Дважды используется как секрет:
#   1) вход в админку LiteLLM на llm.esmien.qd.je (UI_USERNAME + этот пароль);
#   2) API-ключ, с которым Open WebUI обращается к LiteLLM (/v1) — уходит в
#      OPENAI_API_KEY контейнера open-webui.
# Смена: правится здесь → пересоздать litellm И open-webui (иначе webui отвалится 401).
# Генерация: openssl rand -hex 32
LITELLM_MASTER_KEY=CHANGE_ME

# [обязательна] Ключ OpenRouter — upstream для моделей, у которых нет своего
# провайдера/ключа внутри LiteLLM. Кабинет: openrouter.ai → Keys.
OPENROUTER_API_KEY=CHANGE_ME

# ==== Open WebUI ====

# [обязательна] Секрет подписи сессий и JWT Open WebUI. Смена = разлогин всех
# клиентов и инвалидация выданных токенов. Генерация: openssl rand -hex 32
WEBUI_SECRET_KEY=CHANGE_ME

# [обязательна] API-ключ open-terminal — веб-терминала, которому проброшен
# /var/run/docker.sock. Кто знает ключ, тот root на хосте: только openssl rand -hex 32,
# никогда не переиспользовать другие ключи.
OPEN_TERMINAL_API_KEY=CHANGE_ME

# [обязательна] Логин администратора Open WebUI (роль admin создаётся при первом
# старте с пустой БД; на существующей БД значение не переигрывается).
UI_USERNAME=CHANGE_ME

# [обязательна] Пароль администратора Open WebUI. Смена в .env не меняет пароль
# в базе — менять через UI (Настройки → Аккаунт) или psql.
UI_PASSWORD=CHANGE_ME

# Разрешить администратору открывать и продолжать чужие чаты (true/false).
# Деплой одноюзерский → допустимо true, но по умолчанию false.
ENABLE_ADMIN_CHAT_ACCESS=false

# Разрешить сохранённые в Integrations tool-серверы и Open Terminal
# использоваться в чатах (true/false). С 0.12.4 при false они молча
# выкидываются из чата — здесь нужен true, иначе терминал отвалится.
ENABLE_DIRECT_INTEGRATIONS=true

# ==== PostgreSQL 17 на хосте (роли создаёт deploy.sh, auth по паролю) ====

# [обязательна] Пароль роли litellm: в litellm_db живут модели, ключи провайдеров
# и спенд-логи. Используется в DATABASE_URL контейнера litellm и в backup-databases.sh.
LITELLM_DB_PASSWORD=CHANGE_ME

# [обязательна] Пароль роли webui: чаты, загруженные файлы, pgvector-эмбеддинги.
# Используется в DATABASE_URL/PGVECTOR_DB_URL open-webui и в backup-databases.sh.
WEBUI_DB_PASSWORD=CHANGE_ME

# ==== SearXNG (веб-поиск для RAG в Open WebUI) ====

# [обязательна] Секрет SearXNG: подпись внутренних запросов и limiter.toml.
# Генерация: openssl rand -hex 32
SEARXNG_SECRET_KEY=CHANGE_ME

# ==== Redis (состояние роутера, auth и rate-limit LiteLLM) ====

# Пароль litellm-redis. Подставляется и в команду redis-server (--requirepass),
# и в REDIS_PASSWORD самого litellm. Пусто = redis без авторизации: работать будет,
# но любой контейнер в stack-net прочитает состояние лимитов. Генерация: openssl rand -hex 32
LITELLM_REDIS_PASSWORD=CHANGE_ME

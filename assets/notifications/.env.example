# Не коммитьте заполненный .env с реальным токеном.
BOT_TOKEN=123456:replace_me
BOT_OWNER=123456789

BACKUP_DIR=/var/backups
BACKUP_PATTERN=*.sql.gz
MONITOR_DISK_PATH=/
MONITOR_STATE_FILE=/var/lib/server-monitor/state.json
MONITOR_ALERT_STATE_FILE=/var/lib/server-monitor/alerts.json
# Необязательно; по умолчанию /var/lib/server-monitor/bot_state.json
# MONITOR_BOT_STATE_FILE=/var/lib/server-monitor/bot_state.json
MAX_BACKUP_AGE_HOURS=26
DISK_WARN_PERCENT=85
DISK_CRIT_PERCENT=95
INODE_WARN_PERCENT=85
INODE_CRIT_PERCENT=95
# Необязательно; regex должен содержать группу (?P<date>...).
# BACKUP_DATE_REGEX=(?P<date>\\d{4}-\\d{2}-\\d{2})

# Необязательно; мониторинг событий Docker (server-monitor-events.service).
# MONITOR_EVENT_WINDOW_SECONDS=60        # окно батчинга и троттлинга (сек)
# MONITOR_EVENT_LOG_TAIL_START=50        # строк логов при старте
# MONITOR_EVENT_LOG_TAIL_STOP=20         # строк логов при падении/OOM
# MONITOR_RESTART_COOLDOWN_SECONDS=600   # пауза между уведомлениями о петле рестарта

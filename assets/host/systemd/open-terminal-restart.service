[Unit]
Description=Nightly restart of open-terminal (resets glibc heap floor)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /usr/local/bin/open-terminal-restart.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target

[Unit]
Description=Issue TLS certificate for mon.<domain> (retries on Let's Encrypt rate limit)
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/mon-cert-setup.sh
# exit 1 = «сертификат пока не выпущен, ждём рейтрай» — не считаем падением юнита
SuccessExitStatus=1

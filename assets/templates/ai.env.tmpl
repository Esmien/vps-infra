# ─────────────────────────────────────────────────────────────────────────────
# Секреты AI-стека. Файл создаётся установщиком vps-infra (install.py).
# Права: 0640 root:ai_service. В git не попадает.
#
# Значения, помеченные [gen], установщик генерирует сам (openssl rand -hex 32).
# При повторном запуске существующие значения переиспользуются.
# ─────────────────────────────────────────────────────────────────────────────

# ==== LiteLLM ====

# Мастер-ключ шлюза. Используется дважды: вход в админку LiteLLM
# (вместе с UI_USERNAME) и как OPENAI_API_KEY для Open WebUI.
LITELLM_MASTER_KEY=@@LITELLM_MASTER_KEY@@

# Ключ OpenRouter — upstream для моделей без собственного провайдера.
# openrouter.ai → Keys. Можно оставить пустым, если все модели идут через
# свои ключи/локальные провайдеры.
OPENROUTER_API_KEY=@@OPENROUTER_API_KEY@@

# ==== Open WebUI ====

# Секрет подписи сессий и JWT. Смена = разлогин всех клиентов.
WEBUI_SECRET_KEY=@@WEBUI_SECRET_KEY@@

# API-ключ open-terminal (веб-терминал с доступом к docker.sock = root на хосте).
OPEN_TERMINAL_API_KEY=@@OPEN_TERMINAL_API_KEY@@

# Логин администратора. Админ в Open WebUI создаётся при первом старте на пустой
# БД через форму регистрации; на восстановленной БД значения не переигрываются.
UI_USERNAME=@@UI_USERNAME@@

# Пароль администратора LiteLLM. Пароль админа Open WebUI меняется только в UI.
UI_PASSWORD=@@UI_PASSWORD@@

ENABLE_ADMIN_CHAT_ACCESS=@@ENABLE_ADMIN_CHAT_ACCESS@@

# Публичный адрес Open WebUI (нужен ему для ссылок и CORS).
WEBUI_URL=@@WEBUI_URL@@

# ==== PostgreSQL 17 на хосте ====

# Пароль роли litellm: модели, ключи провайдеров, спенд-логи.
LITELLM_DB_PASSWORD=@@LITELLM_DB_PASSWORD@@

# Пароль роли webui: чаты, файлы, pgvector-эмбеддинги.
WEBUI_DB_PASSWORD=@@WEBUI_DB_PASSWORD@@

# ==== SearXNG ====

# Секрет подписи внутренних запросов и limiter.
SEARXNG_SECRET_KEY=@@SEARXNG_SECRET_KEY@@

# ==== Redis (состояние роутера, auth и rate-limit LiteLLM) ====

LITELLM_REDIS_PASSWORD=@@LITELLM_REDIS_PASSWORD@@

# ==== Прочее ====

# Ключ GitHub для бэкапа состояния Hermes (hermes-state-backup.sh).
# Необязателен: без него бэкап состояния Hermes не настраивается.
GITHUB_KEY=@@GITHUB_KEY@@

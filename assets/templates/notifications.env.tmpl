# Telegram-боты мониторинга и бэкапов. Создаётся установщиком vps-infra.
# Права: 0640 root:root. В git не попадает.
#
# BOT_TOKEN   — бот уведомлений (@BotFather), пишет алерты и отвечает на /health.
# FILE_BOT_TOKEN — бот для отправки файлов (бэкапы, документы). Владелец должен
#                  нажать Start в чате с ним, иначе отправка файлов не работает.
# BOT_OWNER   — Telegram user id владельца (узнать: @userinfobot).
# Указано и в owner, и в BOT_TARGET_CHAT? Разные чаты — ошибка, команды авторизуются по
# отправителю, поэтому личка владельца всегда работает.
# BOT_TARGET_CHAT/BOT_TARGET_THREAD       — тема супергруппы для алертов мониторинга
#                                           (например -1004410657647 и 11). Пусто = личка.
# FILE_TARGET_CHAT/FILE_TARGET_THREAD      — то же для ботов, отправляющих файлы (бэкапы).

BOT_TOKEN=@@BOT_TOKEN@@
FILE_BOT_TOKEN=@@FILE_BOT_TOKEN@@
BOT_OWNER=@@BOT_OWNER@@
BOT_TARGET_CHAT=
BOT_TARGET_THREAD=
FILE_TARGET_CHAT=
FILE_TARGET_THREAD=

BACKUP_DIR=@@BACKUP_DIR@@
BACKUP_PATTERN=*.dump
MONITOR_DISK_PATH=/
MONITOR_STATE_FILE=/var/lib/server-monitor/state.json
MONITOR_ALERT_STATE_FILE=/var/lib/server-monitor/alerts.json
MAX_BACKUP_AGE_HOURS=26
DISK_WARN_PERCENT=85
DISK_CRIT_PERCENT=95
INODE_WARN_PERCENT=85
INODE_CRIT_PERCENT=95

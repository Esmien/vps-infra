# /etc/nginx/nginx.conf — stream block (real IP via PROXY protocol)
stream {
    log_format sni '$remote_addr [$time_local] sni=$ssl_preread_server_name bytes_in=$bytes_received bytes_out=$bytes_sent time=$session_time';
    access_log /var/log/nginx/stream-443.log sni;
    
    # accepts PROXY and forwards plain TCP to mtproto (it does not speak PROXY)
    server { listen 127.0.0.1:10445 proxy_protocol; proxy_pass 127.0.0.1:10443; }
    map $ssl_preread_server_name $mtproto_backend {
        www.cloudflare.com 127.0.0.1:10445;
        default 127.0.0.1:9443;
    }
    server {
        listen 443;
        listen [::]:443;
        ssl_preread on;
        proxy_pass $mtproto_backend;
        proxy_protocol on;
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
    }
}
